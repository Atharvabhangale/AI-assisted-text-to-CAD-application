  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/three": "^0.185.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
