# Dependencies
node_modules/
# ...and as a symlink, which the trailing-slash form above does not match.
# apps/web-experimental links to the stable app's install for local dev, and
# a machine-specific path must never be committed.
node_modules
.pnp/
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Evaluation runs: local measurement output, not source. They are also never
# CAD artifacts -- see docs/ai-evaluation.md.
evaluation-results/

# Caches / coverage
.cache/
.turbo/
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
