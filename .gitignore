# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Local development launcher state: process ids, server logs and the build
# cache that start.ps1 creates. Runtime state, never source. No credential is
# ever written here -- start.ps1 puts the key in the backend process's
# environment only.
.dev/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Evaluation runs: local measurement output, not source. They are also never
# CAD artifacts -- see docs/ai-evaluation.md.
evaluation-results/

# Caches / coverage
.cache/
.turbo/
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
